import inventario.*
import wollok.game.*
import personaje.*
import configuraciones.*
import direcciones.*
import obstaculos.*
import factory.*
import enemigos.*
import niveles.*
import mate.*
import vidas.*
import morral.*


program Jacinta {
	config.configurarEscenario()
	config.movimientos()

	game.addVisual(nivel1)

	factoryArbustos.crear()

	game.addVisual(jacinta)

	game.addVisual(mate)

	vidas.actualizar(jacinta.vida())

	game.addVisual(morral)
	
	config.inventario()
	game.start()
}
