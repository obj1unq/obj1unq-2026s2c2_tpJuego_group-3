import inventario.*
import wollok.game.*
import personaje.*
import configuraciones.*
import direcciones.*
import obstaculos.*
import factory.*
import enemigos.*
import vidas.*


program Jacinta {
	config.configurarEscenario()

	config.teclas()

	config.visuales()

	factoryArbustos.crear()

	game.addVisual(jacinta)

	vidas.actualizar(jacinta.vida())
	
	config.inventario()

	game.start()
}
